# --- Yol A: Vertex AI (Google Cloud kredisi ile) -- Cloud Shell'de setup.sh bunu otomatik doldurur
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id
# Yeni modeller bazen yalnizca "global" konumda sunulur. Hata alirsaniz bunu deneyin / us-central1'e cevirin.
GOOGLE_CLOUD_LOCATION=global

# --- Yol B: AI Studio anahtari (yedek). Kullanacaksaniz yukaridaki uc satiri silin/yorumlayin:
# GOOGLE_API_KEY=your-ai-studio-key

# --- Model. Workshop varsayilani: ucuz ve hizli model
MODEL=gemini-3.5-flash-lite
# Maliyet tahmini icin (USD / 1M token). Resmi fiyat sayfasindan teyit edin.
PRICE_IN_PER_M=0.30
PRICE_OUT_PER_M=2.50

# --- Guvenlik agi: tek kosuda en fazla kac model cagrisi yapilabilir (ADK bunu dogrudan okur)
ADK_MAX_LLM_CALLS=25

# --- Ariza enjeksiyonu (Demo 2). Bos birakin; demoda: FAULT=diagnostics_timeout
FAULT=

# --- Kredi harcamadan deneme (egitmen provasi): 1 yapinca sahte model kullanilir
USE_FAKE_MODEL=0
